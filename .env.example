# Neon Postgres — récupère ces 2 URLs depuis le dashboard Neon (onglet "Connection Details")
# DATABASE_URL : connexion "pooled" (via pgbouncer) — utilisée par l'app à l'exécution
# DIRECT_URL   : connexion directe — utilisée par Prisma pour les migrations
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/safibudget?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/safibudget?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genere-avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Clé API Anthropic (pour les 5 fonctionnalités IA — à ajouter quand tu l'auras)
# ANTHROPIC_API_KEY="sk-ant-..."
